{
  "name": "640x480",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11.6.2 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run && npm run test:contracts",
    "test:contracts": "node --test scripts/*.node-test.mjs",
    "test:browser": "playwright test",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "import:year": "node scripts/retired-publication-command.mjs import",
    "import:2013:sample": "node scripts/retired-publication-command.mjs sample-import",
    "import:2013": "node scripts/retired-publication-command.mjs import",
    "import": "node scripts/retired-publication-command.mjs import",
    "archive:inventory": "node scripts/archive-inventory.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "media:upload:dry-run": "node scripts/retired-publication-command.mjs upload",
    "media:upload": "node scripts/retired-publication-command.mjs upload"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "exifr": "^7.1.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
