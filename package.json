    "media:r2:preflight": "node scripts/r2-preflight.mjs",
    "media:r2:test:credentials": "node scripts/r2-package-credentials.mjs",
    "media:r2:test:plan": "node scripts/r2-package-upload.mjs --plan",
    "media:r2:test:publish": "node scripts/r2-package-upload.mjs --execute",
    "media:r2:credentials": "node scripts/r2-package-credentials.mjs",
    "media:r2:plan": "node scripts/r2-package-upload.mjs --plan",
    "media:r2:publish": "node scripts/r2-package-upload.mjs --execute",
    "release:candidate": "node scripts/package-release-activation.mjs",
